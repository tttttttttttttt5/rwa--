<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RWA 学术文献日报 {{ date }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;color:#1f2329;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;">
<tr><td align="center" style="padding:24px 12px;">
<table width="680" cellpadding="0" cellspacing="0" style="max-width:680px;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,.06);">

<!-- 顶部 -->
<tr>
<td style="background:linear-gradient(135deg,#6366f1,#8b5cf6);padding:28px 32px;">
<div style="font-size:13px;color:#e9e7ff;letter-spacing:2px;">RWA · DeFi · BLOCKCHAIN FINANCE</div>
<div style="font-size:24px;font-weight:700;color:#ffffff;margin-top:6px;">RWA 学术文献日报</div>
<div style="font-size:13px;color:#e9e7ff;margin-top:6px;">{{ date }} &nbsp;|&nbsp; 统计窗口 {{ window }}</div>
</td>
</tr>

<!-- 概览 -->
<tr>
<td style="padding:20px 32px 8px;">
<table width="100%" cellpadding="0" cellspacing="0">
<tr>
<td style="width:33%;text-align:center;background:#f8f9fb;border-radius:10px;padding:14px 6px;">
<div style="font-size:26px;font-weight:700;color:#6366f1;">{{ stats.fetched }}</div>
<div style="font-size:12px;color:#6b7280;">抓取论文</div>
</td>
<td style="width:34%;text-align:center;background:#f8f9fb;border-radius:10px;padding:14px 6px;margin:0 6px;">
<div style="font-size:26px;font-weight:700;color:#10b981;">{{ stats.selected }}</div>
<div style="font-size:12px;color:#6b7280;">入选论文</div>
</td>
<td style="width:33%;text-align:center;background:#f8f9fb;border-radius:10px;padding:14px 6px;">
<div style="font-size:14px;font-weight:600;color:#1f2329;line-height:1.5;">
{% for src, n in stats.by_source.items() %}{{ src }}:{{ n }} {% endfor %}</div>
<div style="font-size:12px;color:#6b7280;">来源分布</div>
</td>
</tr>
</table>
<div style="font-size:12px;color:#6b7280;margin-top:10px;">评分阈值 ≥ {{ threshold }} ｜ 特殊关注作者不受阈值限制</div>
</td>
</tr>

<!-- Top picks -->
{% if top_picks %}
<tr>
<td style="padding:8px 32px 0;">
<div style="font-size:16px;font-weight:700;color:#1f2329;border-left:4px solid #8b5cf6;padding-left:10px;">★ 今日最值得精读</div>
</td>
</tr>
{% for pick in top_picks %}
<tr>
<td style="padding:12px 32px 0;">
<div style="background:#fbfaff;border:1px solid #ece9ff;border-radius:10px;padding:14px 16px;">
<div style="font-size:14px;font-weight:600;color:#4c1d95;">
<a href="{{ pick.paper.url }}" style="color:#4c1d95;text-decoration:none;">{{ pick.paper.title }}</a>
<span style="font-weight:400;color:#8b5cf6;"> · {{ '%.0f'|format(pick.paper.final_score) }}分</span>
</div>
<div style="font-size:13px;color:#5b4670;margin-top:6px;">{{ pick.reason }}</div>
<div style="font-size:12px;color:#9ca3af;margin-top:4px;">{{ pick.paper.source }} · {{ pick.paper.journal }}</div>
</div>
</td>
</tr>
{% endfor %}
{% endif %}

<!-- 整体大总结 + 可借鉴要点 -->
{% if synthesis_overview or synthesis_takeaways %}
<tr>
<td style="padding:8px 32px 0;">
<div style="font-size:16px;font-weight:700;color:#1f2329;border-left:4px solid #f59e0b;padding-left:10px;">整体大总结 & 可借鉴要点</div>
</td>
</tr>
<tr>
<td style="padding:12px 32px 0;">
<div style="background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:14px 16px;">
{% if synthesis_overview %}
<div style="font-size:13px;color:#78350f;line-height:1.7;">{{ synthesis_overview }}</div>
{% endif %}
{% if synthesis_takeaways %}
<div style="margin-top:10px;font-size:12px;font-weight:600;color:#92400e;">可借鉴要点</div>
<ul style="margin:6px 0 0 0;padding-left:20px;">
{% for t in synthesis_takeaways %}<li style="font-size:12px;color:#78350f;line-height:1.6;margin-bottom:3px;">{{ t }}</li>{% endfor %}
</ul>
{% endif %}
</div>
</td>
</tr>
{% endif %}

<!-- 论文列表 -->
<tr>
<td style="padding:18px 32px 4px;">
<div style="font-size:16px;font-weight:700;color:#1f2329;border-left:4px solid #6366f1;padding-left:10px;">入选论文列表（按分数降序）</div>
</td>
</tr>

{% for r in rows %}
<tr>
<td style="padding:8px 32px;">
<div style="border:1px solid #eef0f3;border-radius:10px;padding:14px 16px;">
<table width="100%" cellpadding="0" cellspacing="0">
<tr>
<td style="vertical-align:top;">
<div style="font-size:14px;font-weight:600;color:#1f2329;line-height:1.45;">
{% if r.watched %}<span style="color:#dc2626;">★</span> {% endif %}
<a href="{{ r.url }}" style="color:#1f2329;text-decoration:none;">{{ r.title }}</a>
</div>
<div style="font-size:12px;color:#6b7280;margin-top:4px;">{{ r.authors }} · {{ r.source }} · {{ r.journal }}</div>
{% if r.digest %}<div style="font-size:12px;color:#4c1d95;margin-top:6px;">导读：{{ r.digest }}</div>{% endif %}
{% if r.summary_content or r.summary_method or r.summary_takeaway %}
<div style="margin-top:8px;padding:8px 10px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;">
{% if r.summary_content %}<div style="font-size:12px;color:#14532d;line-height:1.6;"><span style="color:#15803d;font-weight:600;">研究内容：</span>{{ r.summary_content }}</div>{% endif %}
{% if r.summary_method %}<div style="font-size:12px;color:#14532d;line-height:1.6;margin-top:3px;"><span style="color:#15803d;font-weight:600;">方法：</span>{{ r.summary_method }}</div>{% endif %}
{% if r.summary_takeaway %}<div style="font-size:12px;color:#14532d;line-height:1.6;margin-top:3px;"><span style="color:#15803d;font-weight:600;">可借鉴：</span>{{ r.summary_takeaway }}</div>{% endif %}
</div>
{% endif %}
{% if r.abstract %}<div style="font-size:12px;color:#4b5563;margin-top:6px;line-height:1.55;">{{ r.abstract }}</div>{% endif %}
</td>
<td style="width:60px;text-align:center;vertical-align:middle;">
<div style="font-size:18px;font-weight:700;color:#6366f1;">{{ '%.0f'|format(r.score) }}</div>
<div style="font-size:10px;color:#9ca3af;">分</div>
</td>
</tr>
<tr>
<td colspan="2" style="padding-top:8px;">
{% for kw in r.keywords %}<span style="display:inline-block;font-size:11px;background:#eef2ff;color:#4338ca;border-radius:8px;padding:2px 8px;margin:2px 4px 0 0;">{{ kw }}</span>{% endfor %}
</td>
</tr>
</table>
</div>
</td>
</tr>
{% else %}
<tr><td style="padding:18px 32px;color:#6b7280;font-size:13px;">今日无论文达到阈值，可尝试降低 config.yaml 中的 scoring.threshold。</td></tr>
{% endfor %}

<!-- 引用图说明 -->
<tr>
<td style="padding:18px 32px 4px;">
<div style="font-size:16px;font-weight:700;color:#1f2329;border-left:4px solid #10b981;padding-left:10px;">论文关联图说明</div>
</td>
</tr>
<tr>
<td style="padding:8px 32px;">
<div style="background:#f8f9fb;border-radius:10px;padding:14px 16px;font-size:12px;color:#374151;line-height:1.7;">
{{ citation_text | replace('\n', '<br>') }}
</div>
</td>
</tr>

<!-- 页脚 -->
<tr>
<td style="padding:18px 32px 28px;">
<div style="border-top:1px solid #eef0f3;padding-top:14px;font-size:11px;color:#9ca3af;line-height:1.6;">
本日报由 RWA Daily Agent 自动生成。修改 <code style="background:#f3f4f6;padding:1px 5px;border-radius:4px;">config/config.yaml</code> 即可调整关键词、期刊优先级、评分阈值与摘要风格，下次运行自动生效。<br>
关键词：{{ keywords | join('、') }}
</div>
</td>
</tr>

</table>
</td></tr>
</table>
</body>
</html>
