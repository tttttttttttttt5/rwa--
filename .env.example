# ---------- Anthropic (Claude) ----------
# 可在 https://console.anthropic.com 获取；若 config.yaml 中 ai.enabled=false 则无需填写
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 邮件 SMTP（126 邮箱） ----------
# 注意：必须使用“客户端授权码”，不是邮箱登录密码
# 获取方式：登录 mail.126.com → 设置 → POP3/SMTP/IMAP → 开启 SMTP → 生成授权码
SMTP_HOST=smtp.126.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=zhang200202409@126.com
SMTP_PASSWORD=你的126授权码
SMTP_FROM=zhang200202409@126.com

# ---------- Google Scholar Alerts（可选） ----------
# 仅当 config.yaml 中 sources.scholar.enabled=true 时需要
SCHOLAR_IMAP_USER=your_email@gmail.com
SCHOLAR_IMAP_PASS=your_app_password
